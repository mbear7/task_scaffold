__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.DS_Store

# Task output files -- regenerated by hr_task.py/ops_task.py on each run,
# not source. Loosen this if a fixture .xlsx is ever intentionally added.
*.xlsx

# Local-only environment workarounds, never part of the real project.
# If these exist in your working copy they are offline stand-ins for the
# real packages in requirements.txt, not source.
/sqlalchemy/
/petl/
/psycopg2/
/petl_util.py
/.claude/

# Live verification scripts: they need a real SMB share, real credentials
# and a real PostgreSQL, so they cannot run in the offline suite and are
# deliberately not part of it. Kept in the tree so they survive rather
# than living in a temp directory, but never committed -- they encode
# infrastructure paths and are run by hand.
/local_tests/
